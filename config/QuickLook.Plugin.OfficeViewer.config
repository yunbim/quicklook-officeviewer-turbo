<?xml version="1.0" encoding="utf-8"?>
<!--
  QuickLook Office 极速预览版 (Turbo) - settings template / 设置模板
  ============================================================================
  设置域 / settings domain : QuickLook.Plugin.OfficeViewer
  正式位置 / real location : %LOCALAPPDATA%\Programs\QuickLook\UserData\
                             QuickLook.Plugin.OfficeViewer.config

  这是一个模板，不是必装文件 —— 全部默认值已经编译在插件里。
  要改设置，请把下面这些键 **合并** 进你自己的 <Settings>，不要整段覆盖。
  改完需要重启 QuickLook 才生效。

  This is a TEMPLATE, not a required file - every default is compiled into the
  plugin. To change something, MERGE the keys below into your existing
  <Settings>; do not replace the whole file. A QuickLook restart is required.
-->
<Settings>
  <!-- True = 首次预览某个 Office 类型后，后台把其余同类处理器也预热好。
       After the first preview of an Office type, warm the remaining handlers
       of that type in the background. -->
  <WarmUpAfterFirstPreview>True</WarmUpAfterFirstPreview>

  <!-- True = 启动即预热全部 Office 处理器，连第一次预览也秒开；
       代价是常驻约 355 MB，由空闲回收兜底。
       True = warm every Office handler at start-up (even the first preview is
       instant). Costs ~355 MB resident, reclaimed by the idle watchdog. -->
  <WarmUpAtStartup>False</WarmUpAtStartup>

  <!-- 空闲多少秒后释放 Office 进程；0 = 永不释放（等同原版行为）。
       Seconds of idleness before the Office processes are released.
       0 = never release (stock behaviour). -->
  <HandlerIdleTimeoutSeconds>1800</HandlerIdleTimeoutSeconds>

  <!-- True = 把每次预览的耗时写进 UserData\QuickLook.Exception.log。
       True = append each preview's duration to UserData\QuickLook.Exception.log -->
  <LogPreviewTiming>False</LogPreviewTiming>

  <!-- 提示条语言 / language of the Protected View notice strip:
       auto = 跟随 Windows 界面语言 / follow the Windows UI language (默认)
       zh   = 始终中文 / always Chinese
       en   = 始终英文 / always English -->
  <UiLanguage>auto</UiLanguage>
</Settings>
