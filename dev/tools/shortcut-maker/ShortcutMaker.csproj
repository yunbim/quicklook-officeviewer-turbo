<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>ShortcutMaker</AssemblyName>
    <RootNamespace>ShortcutMaker</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Reuse QuickLook's own IShellLinkW wrapper instead of re-declaring the interop. -->
    <Compile Include="..\..\repo\QuickLook\NativeMethods\ShellLink.cs" />
  </ItemGroup>

</Project>
